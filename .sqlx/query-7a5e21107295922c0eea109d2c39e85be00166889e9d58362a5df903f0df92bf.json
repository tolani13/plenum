{
  "db_name": "PostgreSQL",
  "query": "SELECT a.id, a.kind AS \"kind: ActivityKind\", a.body,\n                  a.occurred_at, u.name AS rep_name\n           FROM activities a JOIN users u ON u.id = a.rep_id\n           WHERE a.account_id = $1\n           ORDER BY a.occurred_at DESC, a.id DESC\n           LIMIT $2",
