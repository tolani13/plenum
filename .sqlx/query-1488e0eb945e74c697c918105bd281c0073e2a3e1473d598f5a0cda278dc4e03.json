{
  "db_name": "PostgreSQL",
  "query": "SELECT u.id, u.name, u.role AS \"role: UserRole\"\n           FROM users u\n           WHERE EXISTS (\n               SELECT 1 FROM v_user_scope vs\n               JOIN accounts a ON a.territory_id = vs.territory_id\n               WHERE vs.user_id = u.id AND a.id = $1\n           )\n           ORDER BY u.name, u.id",
