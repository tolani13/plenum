  "query": "SELECT c.id, c.site_id, c.name, c.title, c.email, c.phone, c.role\n           FROM contacts c\n           JOIN sites s ON s.id = c.site_id\n           JOIN accounts a ON a.id = s.account_id\n           WHERE a.id = $1 ORDER BY c.name, c.id",
