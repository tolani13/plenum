  "query": "SELECT a.id, a.name, a.industry, a.status AS \"status: AccountStatus\",\n                  t.code AS \"territory_code!\", a.parent_account_id, a.created\n           FROM accounts a\n           JOIN territories t ON t.id = a.territory_id\n           ORDER BY a.name, a.id\n           LIMIT $1 OFFSET $2",
