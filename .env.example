# Copy to .env and fill in. The checked-in defaults below match the dev-only
# docker-compose.yml database. No production secret ever goes in this file.

# Admin connection — used ONLY by migrations and the seed binary. This role is
# the table owner / superuser and bypasses RLS by design.
DATABASE_URL=postgres://plenum_admin:<password-from-docker-compose>@localhost:5434/plenum

# App connection — the ONLY connection the API uses. RLS applies to this role.
APP_DATABASE_URL=postgres://plenum_app:<password-from-docker-initdb>@localhost:5434/plenum

# Session cookie Secure flag. The code default is true (production posture).
# Set false for plain-HTTP localhost dev, or curl/browsers will refuse to send
# the session cookie over http://localhost.
COOKIE_SECURE=false

# API bind address.
BIND_ADDR=127.0.0.1:5777

# Log filter (tracing-subscriber EnvFilter syntax).
RUST_LOG=info

# ── P4 AI layer ──────────────────────────────────────────────────────────────
# The Anthropic API key. SECRET — lives ONLY in .env (gitignored), never in any
# committed file, never in the client bundle, never in a log line. Leave empty
# to run with AI off: every screen still works and Ask PLENUM serves the
# saved-question library (spec §6 flag-off posture, gate P4-2).
ANTHROPIC_API_KEY=

# Model id for the one backend Anthropic call (Ask PLENUM SQL generation + the
# discount-recommendation narrative). Any current model id works; no code
# change needed to swap.
ANTHROPIC_MODEL=claude-sonnet-5

# Feature flags (spec §6: all AI features flagged; app fully demoable with
# flags off). Effective-enabled for Ask = flag AND key present.
AI_ASK_ENABLED=true
AI_DISCOUNT_ENABLED=true
